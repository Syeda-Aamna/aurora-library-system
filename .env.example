# Keep every value private; configure these only in your local ignored .env or the host's encrypted server environment.
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>/<database>?retryWrites=true&w=majority
SESSION_SECRET=replace-with-a-random-secret-at-least-32-characters
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=replace-with-a-strong-password
# The app seeds fictional demo records only when the database is entirely empty. Set false to disable.
SEED_DEMO_DATA=true
# Local preview only: enable the labeled in-memory librarian demo when MongoDB is absent.
# It is disabled automatically in production and whenever MONGODB_URI is configured.
# DEMO_MODE=true
# When this local server is exposed through a public HTTPS reverse-proxy preview, set true for Secure/SameSite=None session cookies.
# PUBLIC_HTTPS_PREVIEW=true
PORT=3001
