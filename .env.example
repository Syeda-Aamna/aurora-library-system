# Keep every value private; use an ignored local .env or the host's encrypted server environment.
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>/<database>?retryWrites=true&w=majority
SESSION_SECRET=replace-with-a-random-secret-at-least-32-characters
ADMIN_EMAIL=staff@your-library.org
ADMIN_PASSWORD=replace-with-a-strong-password
# On first connection, add the verified real starter catalog only if the database has no books, members, or loans.
# All starter records begin with quantity=0 and availableQuantity=0. Set false to skip the one-time seed.
SEED_STARTER_CATALOG=true
# Local only: set true when a public HTTPS preview proxies this local server, for Secure/SameSite=None staff cookies.
# PUBLIC_HTTPS_PREVIEW=true
PORT=3001
